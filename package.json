{
  "name": "noodle-bowl",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:dev": "cross-env EXPO_PUBLIC_USE_EMULATOR=true expo start --clear",
    "start:qa": "cross-env EXPO_PUBLIC_USE_EMULATOR=false EXPO_PUBLIC_COLLECTION_PREFIX=qa_ expo start --clear",
    "start:qa:tunnel": "cross-env EXPO_PUBLIC_USE_EMULATOR=false EXPO_PUBLIC_COLLECTION_PREFIX=qa_ expo start --clear --tunnel",
    "start:prod_smoke": "cross-env EXPO_PUBLIC_USE_EMULATOR=false expo start --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:rules": "jest --config jest.rules.config.js",
    "emulator": "firebase emulators:start",
    "emulator:kill": "taskkill /F /IM java.exe 2>nul & echo Killed emulator processes",
    "avd": "%LOCALAPPDATA%/Android/Sdk/emulator/emulator -avd Pixel_9 -no-snapshot-load",
    "android:wipe": "adb shell pm clear host.exp.exponent",
    "link:challenge": "node scripts/open-deep-link.js challenge",
    "link:help": "node scripts/open-deep-link.js help",
    "seed:emulator": "node scripts/seed-content.js",
    "seed:prod": "cross-env SEED_TARGET=prod node scripts/seed-content.js",
    "pipeline:ingest": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/ingest-weird.ts && ts-node --transpile-only --project pipeline/tsconfig.json pipeline/ingest.ts",
    "pipeline:ingest:bulk": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/ingest-weird.ts && ts-node --transpile-only --project pipeline/tsconfig.json pipeline/ingest.ts --days=4 --pages=15",
    "pipeline:ingest:researched": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/ingest-researched.ts",
    "pipeline:select": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/select.ts",
    "pipeline:generate": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/generate.ts",
    "pipeline:eval": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/eval.ts",
    "pipeline:review": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/review.ts",
    "pipeline:publish": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/publish.ts",
    "pipeline:publish:auto": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/publish.ts --yes",
    "pipeline:publish:force": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/publish.ts --yes --force",
    "pipeline:publish:emulator": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/publish.ts --emulator",
    "pipeline:daily": "npm run pipeline:ingest && npm run pipeline:ingest:researched && npm run pipeline:select && npm run pipeline:generate && npm run pipeline:publish:auto",
    "pipeline:recover": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/recover.ts",
    "pipeline:recover:week": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/recover-week.ts",
    "pipeline:status": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/status.ts",
    "pipeline:ui": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/ui-server.ts",
    "pipeline:fix-cross-game-dupes": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/fix-cross-game-dupes.ts",
    "pipeline:ingest:web-historical": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/ingest-web-historical.ts",
    "pipeline:historical": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/historical.ts",
    "pipeline:historical:2025-q1": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/historical.ts --quarter=2025-Q1",
    "pipeline:historical:2025-q2": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/historical.ts --quarter=2025-Q2",
    "pipeline:historical:2025-q3": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/historical.ts --quarter=2025-Q3",
    "pipeline:historical:2025-q4": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/historical.ts --quarter=2025-Q4",
    "pipeline:historical:2026-q1": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/historical.ts --quarter=2026-Q1",
    "pipeline:historical:2026-q2": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/historical.ts --quarter=2026-Q2-partial",
    "eval:lede": "npm --prefix evals run eval:lede",
    "eval:spread": "npm --prefix evals run eval:spread",
    "eval:sof": "npm --prefix evals run eval:sof",
    "eval:all": "npm run eval:lede && npm run eval:spread && npm run eval:sof",
    "eval:view": "npm --prefix evals run view",
    "eval:batch": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/eval-batch.ts",
    "eval:extract-fixtures": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/extract-fixtures.ts",
    "pipeline:fix-sof-fakes": "ts-node --transpile-only --project pipeline/tsconfig.json pipeline/fix-sof-fakes.ts",
    "pipeline:fix-sof-fakes:all": "cross-env FIX_SOF_ALL=true ts-node --transpile-only --project pipeline/tsconfig.json pipeline/fix-sof-fakes.ts"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.33",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.10",
    "firebase": "^11.10.0",
    "posthog-react-native": "^4.43.13",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.94.0",
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "29.5.14",
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.0",
    "better-sqlite3": "^12.9.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "firebase-tools": "^15.15.0",
    "google-auth-library": "^10.6.2",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
