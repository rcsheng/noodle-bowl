# Firebase project config — copy to .env.local (not committed)
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Emulator host — leave unset for simulators (iOS defaults to localhost, Android to 10.0.2.2).
# Set to your machine's LAN IP (e.g. 192.168.1.154) when testing on a physical device via Expo Go.
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.154

# Set to "false" to point a dev build at production Firebase instead of the emulator.
# Default behavior (unset): dev builds connect to the local emulator.
# Production builds always hit prod regardless of this flag.
# EXPO_PUBLIC_USE_EMULATOR=false
