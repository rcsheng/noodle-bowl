# Firebase project config — copy to .env.local (not committed)
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# Emulator host — leave unset (defaults to localhost) for iOS Simulator / Android Emulator.
# Set to your machine's LAN IP (e.g. 192.168.1.154) when testing on a physical device via Expo Go.
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.154
