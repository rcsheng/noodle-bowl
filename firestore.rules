rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /challenges/{token} {
      // Any authenticated user can read (friend opening the link)
      allow read: if request.auth != null;
      // Only the sender can create their own challenge
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.senderId;
      // Only Cloud Functions (Admin SDK) can update — enforced by denying client updates
      allow update: if false;
      allow delete: if false;
    }

    // Mirror of challenges for QA smoke testing — same rules, isolated data
    match /qa_challenges/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.senderId;
      allow update: if false;
      allow delete: if false;
    }

    match /helpRequests/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.askerId;
      allow update: if false;
      allow delete: if false;
    }

    // Mirror of helpRequests for QA smoke testing — same rules, isolated data
    match /qa_helpRequests/{token} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.askerId;
      allow update: if false;
      allow delete: if false;
    }

    match /pushTokens/{uid} {
      // Each device manages only its own push token
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /contentVersions/{versionId} {
      // Any authenticated user can read game content
      allow read: if request.auth != null;
      // Only Cloud Functions / Admin SDK can write (client writes denied)
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /friendInteractions/{interactionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /meta/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
